<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:EduDriver"
             xmlns:converters="clr-namespace:Rootfly.Mobile.Core.UI.Converters;assembly=Rootfly.Mobile.Core.UI"
             xmlns:localConverters="clr-namespace:EduDriver.Converters"
             x:Class="EduDriver.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <localConverters:BoolToTripStatusColorConverter x:Key="BoolToTripStatusColorConverter" />
            <localConverters:BoolToTripIconConverter x:Key="BoolToTripIconConverter" />
            <localConverters:BoolToBoardingStatusConverter x:Key="BoolToBoardingStatusConverter" />
            <localConverters:StopProgressConverter x:Key="StopProgressConverter" />
            <localConverters:InvertBoolConverter x:Key="InvertBoolConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
