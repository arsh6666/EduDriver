<?xml version="1.0" encoding="utf-8" ?>
<ui:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Rootfly.Mobile.Core.UI.Pages;assembly=Rootfly.Mobile.Core.UI"
    xmlns:vm="clr-namespace:EduDriver.Shared.ViewModels;assembly=EduDriver.Shared"
    xmlns:dtos="clr-namespace:EduDriver.Shared.Education.Dtos;assembly=EduDriver.Shared"
    x:Class="EduDriver.Views.Phone.RoutePhonePage"
    x:TypeArguments="vm:RouteDetailViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">
            <!-- Route header -->
            <Frame Padding="16" CornerRadius="12" BorderColor="Transparent"
                   BackgroundColor="{StaticResource Primary}" HasShadow="True">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Route.Name, FallbackValue='My Route'}" FontSize="20"
                           FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding TotalStudents, StringFormat='{0} students on this route'}"
                           FontSize="13" TextColor="#CCFFFFFF" />
                </VerticalStackLayout>
            </Frame>

            <!-- Stops timeline -->
            <Label Text="Stops" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0" />

            <CollectionView ItemsSource="{Binding Stops}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:TransportStopDto">
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto" Padding="0,4">
                            <!-- Timeline connector -->
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="0">
                                <BoxView WidthRequest="2" HeightRequest="8"
                                         Color="{StaticResource Primary}" HorizontalOptions="Center" />
                                <Frame WidthRequest="28" HeightRequest="28" CornerRadius="14"
                                       Padding="0" HasShadow="False" BorderColor="{StaticResource Primary}"
                                       BackgroundColor="{StaticResource Primary}">
                                    <Label Text="{Binding SequenceOrder}" FontSize="12"
                                           TextColor="White" HorizontalOptions="Center"
                                           VerticalOptions="Center" FontAttributes="Bold" />
                                </Frame>
                                <BoxView WidthRequest="2" HeightRequest="8"
                                         Color="{StaticResource Primary}" HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <!-- Stop card -->
                            <Frame Grid.Column="1" Padding="12" CornerRadius="10"
                                   BorderColor="Transparent" HasShadow="True" Margin="4,2"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="{Binding Address}" FontSize="12" TextColor="Gray"
                                           IsVisible="{Binding Address, Converter={StaticResource StringToVisibilityConverter}}" />
                                    <HorizontalStackLayout Spacing="12">
                                        <Label FontSize="11" TextColor="{StaticResource Primary}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Pickup: " FontAttributes="Bold" />
                                                    <Span Text="{Binding PickupTime, StringFormat='{0:hh\\:mm}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontSize="11" TextColor="Gray">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Dropoff: " FontAttributes="Bold" />
                                                    <Span Text="{Binding DropoffTime, StringFormat='{0:hh\\:mm}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>

</ui:BaseContentPage>
